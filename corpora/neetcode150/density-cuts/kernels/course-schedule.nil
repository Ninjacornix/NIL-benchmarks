record Adj(head:v,next:v,to:v)
record Row(data:v,size:i)
record Progress(counts:v,queue:v,tail:i)
(v)=b(a,c(a),d(a))
(v,Adj,v)=e(a,b,c,@(c,!buffer(#c,0),0,0;d<#a;a,a[d]==0?b[c:d]:b,a[d]==0?c+1:c,d+1;Row(b,c)))
(v):Adj=@(a,!buffer(a[0],-1),!buffer(a[1],-1),!buffer(a[1],0),0;e<a[1];source=a[2+2*e];target=a[3+2*e];head=b[source];a,b[source:e],c[e:head],d[e:target],e+1;Adj(b,c,d))
(v):v=@(a,!buffer(a[0],0),0;c<a[1];a,b[a[3+2*c]:b[a[3+2*c]]+1],c+1;b)
(v,Adj,v,Row)=@(a,b,Progress(c,d.data,d.size),0;d<c.tail;a,b,f(b,c,c.queue[d]),d+1;d==a[0]?1:0)
(Adj,Progress,i):Progress=@(a,b,a.head[c];c!=-1;a,g(a,b,a.to[c]),a.next[c];b)
(Adj,Progress,i):Progress=count=b.counts[c];queue=b.queue;tail=b.tail;counts=b.counts[c:count-1];Progress(counts,count==1?queue[tail:c]:queue,count==1?tail+1:tail)
